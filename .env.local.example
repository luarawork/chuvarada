# Supabase
NEXT_PUBLIC_SUPABASE_URL=           # URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Chave pública (anon) do Supabase
SUPABASE_DB_PASSWORD=               # Senha do banco de dados
SUPABASE_CONNECTION_STRING=         # String de conexão PostgreSQL direta
SUPABASE_SERVICE_KEY=               # service_role key -- Supabase Dashboard > Settings > API > Project API keys > service_role
                                     # secret. NUNCA expor no cliente (só lida em app/api/suggestions/*, server-side) --
                                     # usada pela página interna /sugestoes pra ler/atualizar todas as sugestões, já que
                                     # a policy de RLS de user_suggestions só permite cada usuário ler as próprias.

# Cron
CRON_SECRET=                        # Token para autenticar chamadas ao cron

# Admin
ADMIN_PASSWORD=                     # Senha para acessar páginas administrativas (/sugestoes)

# Open-Meteo (sem chave — gratuito)
OPENMETEO_DAILY_LIMIT=9500          # Limite diário de chamadas

# WeatherAPI.com (fallback)
WEATHERAPI_KEY=                     # Chave da WeatherAPI.com (gratuita)
WEATHERAPI_DAILY_LIMIT=3000         # Limite diário no plano free

# WorldTides (maré -- fallback pro CPTEC/Marinha, que está fora do ar desde
# 22/07/2026; ver lib/worldtides.ts). Estrutura preparada, ainda não ligada
# a nenhum cron -- deixar em branco não quebra nada, só mantém o fallback
# neutro (0.5) que já existe hoje.
WORLDTIDES_API_KEY=                 # Chave da worldtides.info/apidocs (plano pago ~$4,99/mês, 20.000 créditos)

# Push notifications (Web Push / VAPID -- gerar com `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # Chave pública VAPID para push notifications
VAPID_PRIVATE_KEY=                  # Chave privada VAPID (nunca expor no cliente)
VAPID_EMAIL=mailto:contato@chuvarada.app  # Contato do assinante VAPID (mailto: ou https:)

# Backblaze B2 (histórico)
B2_ENDPOINT=                        # Ex: https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=chuvarada-historico
B2_KEY_ID=                          # keyID da application key do B2
B2_APPLICATION_KEY=                 # applicationKey do B2
B2_BUCKET_ID=                       # ID do bucket do B2

# Segurança
IP_HASH_SALT=                       # Salt para hash de IPs (gerar string aleatória)

# Modo de desenvolvimento
WEATHER_CACHE_ONLY=false            # true = não chamar APIs externas (usa cache)

# OpenTopography (scripts Python de pré-processamento de terreno — não usado pelo app Next.js)
OPENTOPOGRAPHY_API_KEY=
